{
  "name": "museum-on-screen-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/smoke.ts",
    "ingest": "node --env-file-if-exists=.env --import tsx src/ingest.ts",
    "process": "node --env-file-if-exists=.env --import tsx src/pipeline.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.1"
  }
}